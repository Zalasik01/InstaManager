---
/**
 * Metadados de SEO/PWA da página: title, description, canonical absoluto, hreflang,
 * Open Graph, Twitter Card, theme-color, manifest, ícones e robots.
 * Nenhuma requisição a terceiros.
 */
import { SITE } from "@/site";

interface Props {
  titulo: string;
  descricao: string;
  /** Caminho da página, ex.: "/privacidade" (a home é "/"). */
  caminho?: string;
  robots?: string;
  /** "profile" na home, "website" nas demais. */
  tipo?: "website" | "profile";
  /** Título/descrição curtos para redes sociais (padrão: iguais aos da página). */
  ogTitulo?: string;
  ogDescricao?: string;
  imagem?: string;
  imagemAlt?: string;
}

const {
  titulo,
  descricao,
  caminho = "/",
  robots = "index,follow,max-image-preview:large",
  tipo = "website",
  ogTitulo = titulo,
  ogDescricao = descricao,
  imagem = SITE.og.caminho,
  imagemAlt = SITE.og.alt,
} = Astro.props;

const canonical = new URL(caminho, SITE.url).href;
const imagemUrl = new URL(imagem, SITE.url).href;
---

<title>{titulo}</title>
<meta name="description" content={descricao} />
<meta name="robots" content={robots} />
<meta name="theme-color" content={SITE.corTema} />
<meta name="color-scheme" content="dark" />
<meta name="application-name" content={SITE.nome} />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content={SITE.nome} />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="format-detection" content="telephone=no" />

<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="pt-BR" href={canonical} />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/img/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />

<meta property="og:type" content={tipo} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={SITE.nome} />
<meta property="og:title" content={ogTitulo} />
<meta property="og:description" content={ogDescricao} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagemUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(SITE.og.largura)} />
<meta property="og:image:height" content={String(SITE.og.altura)} />
<meta property="og:image:alt" content={imagemAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitulo} />
<meta name="twitter:description" content={ogDescricao} />
<meta name="twitter:image" content={imagemUrl} />
<meta name="twitter:image:alt" content={imagemAlt} />
