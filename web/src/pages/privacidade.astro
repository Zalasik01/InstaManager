---
import { getEntry, render } from "astro:content";
import Legal from "@/layouts/Legal.astro";

const entrada = await getEntry("legal", "privacidade");
if (!entrada) throw new Error("Falta src/content/legal/privacidade.md");
const { Content } = await render(entrada);
---

<Legal {...entrada.data} caminho="/privacidade"><Content /></Legal>
