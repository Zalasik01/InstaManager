---
import { getEntry } from "astro:content";
import ProfileStats from "@/components/ProfileStats";
import ProfileTabs from "@/components/ProfileTabs";
import ShareButton from "@/components/ShareButton";
import Base from "@/layouts/Base.astro";
import { montarFicha } from "@/lib/ficha";
import { SITE } from "@/site";

const carro = await getEntry("carro", "carro");
const links = await getEntry("links", "links");
if (!carro || !links) throw new Error("Faltam src/content/carro/carro.json ou links/links.json");

const ficha = montarFicha(carro.data);
const itens = links.data.itens;

const titulo = `Polo 9n4 (@${SITE.perfil}) | VW Polo 2012 branco 9n4`;
const ogTitulo = `Polo 9n4 (@${SITE.perfil})`;
const ogDescricao = "VW Polo 2012 branco, geração 9n4. Fotos e ficha do carro.";

// Dados estruturados: o site e a página de perfil do carro (sem dados pessoais).
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      name: SITE.nome,
      url: `${SITE.url}/`,
      inLanguage: "pt-BR",
      sameAs: [SITE.instagram],
    },
    {
      "@type": "ProfilePage",
      "@id": `${SITE.url}/#profile`,
      url: `${SITE.url}/`,
      name: ogTitulo,
      inLanguage: "pt-BR",
      isPartOf: { "@id": `${SITE.url}/#website` },
      description: SITE.descricao,
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: `${SITE.url}${SITE.og.caminho}`,
        width: SITE.og.largura,
        height: SITE.og.altura,
      },
      about: {
        "@type": "Car",
        "@id": `${SITE.url}/#carro`,
        name: "Volkswagen Polo 2012 (9n4)",
        brand: { "@type": "Brand", name: "Volkswagen" },
        model: "Polo",
        vehicleModelDate: "2012",
        color: "Branco",
        vehicleEngine: { "@type": "EngineSpecification", name: "1.6 8v Flex EA111" },
        vehicleTransmission: "Manual 5 marchas",
        image: `${SITE.url}${SITE.og.caminho}`,
      },
      sameAs: [SITE.instagram],
    },
  ],
};
---

<Base
  titulo={titulo}
  descricao={SITE.descricao}
  caminho="/"
  tipo="profile"
  ogTitulo={ogTitulo}
  ogDescricao={ogDescricao}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section aria-label="Perfil" class="flex flex-col gap-5">
    <div class="flex items-center gap-5">
      <img
        src="/img/icon-192.png"
        width="192"
        height="192"
        alt="Foto de perfil de @polo_9n4_12: VW Polo branco visto de trás"
        fetchpriority="high"
        decoding="async"
        class="border-line size-24 shrink-0 rounded-full border object-cover sm:size-32"
      />
      <div class="flex min-w-0 flex-col gap-3">
        <h1 class="truncate text-xl font-extrabold sm:text-2xl">@{SITE.perfil}</h1>
        <div class="flex flex-wrap gap-2">
          <a
            href={SITE.instagram}
            rel="noopener noreferrer"
            class="bg-accent text-accent-fg rounded-lg px-4 py-2 text-sm font-bold"
            >Seguir no Instagram</a
          >
          <ShareButton
            client:idle
            titulo={ogTitulo}
            texto={ogDescricao}
            url={`${SITE.url}/`}
            rotulo="Compartilhar"
          />
        </div>
      </div>
    </div>

    <ul class="flex gap-8 text-sm">
      <ProfileStats client:load />
      {
        carro.data.fotos && (
          <li class="flex flex-col">
            <b class="text-base">{carro.data.fotos}</b>
            <span class="text-muted">fotos do carro</span>
          </li>
        )
      }
      {
        carro.data.desde && (
          <li class="flex flex-col">
            <b class="text-base">{carro.data.desde}</b>
            <span class="text-muted">desde</span>
          </li>
        )
      }
    </ul>

    <p class="flex flex-col text-sm leading-relaxed">
      <strong>{SITE.bio.titulo}</strong>
      <span>{SITE.bio.texto}</span>
    </p>
  </section>

  <div class="mt-6">
    <ProfileTabs client:load ficha={ficha} links={itens} linksAtualizadoEm={links.data.atualizado_em} />
  </div>
</Base>
