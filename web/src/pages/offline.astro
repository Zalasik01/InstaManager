---
import OfflineActions from "@/components/OfflineActions";
import Base from "@/layouts/Base.astro";
---

<Base
  titulo="Sem conexão | Polo 9n4"
  descricao="Você está sem conexão. Tente de novo ou veja os últimos posts salvos no aparelho."
  caminho="/offline"
  robots="noindex,follow"
  ogDescricao="Página de aviso sem conexão do Polo 9n4."
  classeMain="doc"
>
  <p class="tag">Sem conexão</p>
  <h1>Você está offline</h1>
  <p class="lead">
    Não deu para carregar esta página agora. Confira o Wi-Fi ou os dados móveis e tente de novo.
  </p>
  <OfflineActions client:load />
</Base>
