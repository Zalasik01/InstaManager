---
import "@/styles/global.css";
import latinWoff2 from "@fontsource-variable/nunito-sans/files/nunito-sans-latin-wght-normal.woff2?url";
import InstallPrompt from "@/components/InstallPrompt";
import Seo from "@/components/Seo.astro";
import AutoUpdate from "@/components/AutoUpdate";
import { SITE } from "@/site";

interface Props {
  titulo: string;
  descricao: string;
  caminho?: string;
  robots?: string;
  tipo?: "website" | "profile";
  ogTitulo?: string;
  ogDescricao?: string;
}

const props = Astro.props;
const BUILD_ID = __BUILD_ID__;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="app-versao" content={BUILD_ID} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...props} />
    <!-- Só o subset latin (o que a primeira tela usa) é pré-carregado. -->
    <link rel="preload" href={latinWoff2} as="font" type="font/woff2" crossorigin />
    <!-- Dados estruturados (JSON-LD) e outros itens do <head> de cada página. -->
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg font-sans antialiased">
    <a
      href="#conteudo"
      class="bg-accent text-accent-fg sr-only rounded-md px-3 py-2 font-bold focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50"
      >Pular para o conteúdo</a
    >
    <header class="border-line bg-bg/90 sticky top-0 z-20 border-b backdrop-blur">
      <div class="mx-auto flex h-14 max-w-4xl items-center justify-between px-4">
        <a href="/" class="text-xl font-extrabold tracking-tight">polo<span class="text-accent">9n</span></a>
        <nav aria-label="Principal" class="flex items-center gap-4 text-sm font-semibold">
          <InstallPrompt client:idle />
          <a href={SITE.instagram} rel="noopener noreferrer" class="text-muted hover:text-fg"
            >Instagram</a
          >
        </nav>
      </div>
    </header>

    <main id="conteudo" class="mx-auto max-w-4xl px-4 py-6">
      <slot />
    </main>

    <footer class="border-line text-muted mt-10 border-t py-8 text-sm">
      <nav aria-label="Rodapé" class="mx-auto flex max-w-4xl flex-wrap justify-center gap-x-6 gap-y-2 px-4">
        <a href="/" class="hover:text-fg">Início</a>
        <a href="/privacidade" class="hover:text-fg">Política de Privacidade</a>
        <a href="/termos" class="hover:text-fg">Termos de Serviço</a>
      </nav>
    </footer>

    <AutoUpdate client:idle />
  </body>
</html>
