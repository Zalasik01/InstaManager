---
import "@/styles/global.css";
import latinWoff2 from "@fontsource-variable/nunito-sans/files/nunito-sans-latin-wght-normal.woff2?url";
import AutoUpdate from "@/components/AutoUpdate";
import InstallPrompt from "@/components/InstallPrompt";
import Seo from "@/components/Seo.astro";
import { SITE } from "@/site";

interface Props {
  titulo: string;
  descricao: string;
  caminho?: string;
  robots?: string;
  tipo?: "website" | "profile";
  ogTitulo?: string;
  ogDescricao?: string;
  /** Classe extra do <main> (ex.: "doc" nas páginas de texto). */
  classeMain?: string;
}

const { classeMain, ...seo } = Astro.props;
const home = (seo.caminho ?? "/") === "/";
const BUILD_ID = __BUILD_ID__;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="app-versao" content={BUILD_ID} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {...seo} />
    <!-- Só o subset latin (o que a primeira tela usa) é pré-carregado. -->
    <link rel="preload" href={latinWoff2} as="font" type="font/woff2" crossorigin />
    <!-- Dados estruturados (JSON-LD) e outros itens do <head> de cada página. -->
    <slot name="head" />
  </head>
  <body class="antialiased">
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <header class="bar">
      <div class="wrap">
        <a class="brand" href="/">polo<span>9n</span></a>
        <nav aria-label="Principal">
          {
            home ? (
              <>
                <InstallPrompt client:idle />
                <a href={SITE.instagram} rel="noopener noreferrer">
                  Instagram
                </a>
              </>
            ) : (
              <a href="/">Início</a>
            )
          }
        </nav>
      </div>
    </header>

    <main id="conteudo" class:list={["wrap", classeMain]}>
      <slot />
    </main>

    <footer class="rodape">
      {!home && <a href="/">Início</a>}
      <a href="/privacidade">Política de Privacidade</a>
      <a href="/termos">Termos de Serviço</a>
    </footer>

    <AutoUpdate client:idle />
  </body>
</html>
