{
  // Site polo9n.com.br. O domínio está ativo no Cloudflare: as rotas abaixo ligam o endereço principal e o
  // www (o Worker redireciona o www para o principal). O endereço polo9n.<conta>.workers.dev continua
  // existindo, marcado como noindex, para testes.
  "name": "polo9n",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  // Id da versão de cada deploy: o Worker injeta no sw.js e no HTML para o site se atualizar sozinho.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Toda requisição passa pelo Worker (redireciona www e marca o endereço workers.dev como noindex); os arquivos estáticos continuam saindo de ASSETS.
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_URL": "https://crzmyemggpgjcrwwuwka.supabase.co",
    // Chave publishable do Supabase: pública por desenho (as tabelas têm RLS sem política).
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ymEIzdY3XwK_QJ85yAx2gQ_w33cCiRA"
  },
  "routes": [
    { "pattern": "polo9n.com.br", "custom_domain": true },
    { "pattern": "www.polo9n.com.br", "custom_domain": true }
  ]
}
