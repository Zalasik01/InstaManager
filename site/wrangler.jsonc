{
  // Configuração provisória: publica só no endereço gratuito polo9n.<conta>.workers.dev.
  // Quando o domínio polo9n.com.br estiver ativo no Cloudflare, use wrangler.dominio.jsonc
  // (npx wrangler deploy -c wrangler.dominio.jsonc) para ligar o domínio.
  "name": "polo9n",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Toda requisição passa pelo Worker (redireciona www e marca o endereço workers.dev como noindex); os arquivos estáticos continuam saindo de ASSETS.
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_URL": "https://crzmyemggpgjcrwwuwka.supabase.co",
    // Chave publishable do Supabase: pública por desenho (as tabelas têm RLS sem política).
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ymEIzdY3XwK_QJ85yAx2gQ_w33cCiRA"
  }
}
